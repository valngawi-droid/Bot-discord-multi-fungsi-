# Discord Developer Portal > Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Direkomendasikan saat pengembangan: command langsung muncul di server ini.
DISCORD_GUILD_ID=

# Endpoint OpenAI-compatible milik penyedia/bridge LMArena Anda.
# Nilai harus berakhir dengan /v1 (atau atur endpoint lengkap yang kompatibel).
LMARENA_BASE_URL=https://alamat-api-anda.example/v1
LMARENA_API_KEY=
LMARENA_MODEL=
AI_SYSTEM_PROMPT=Kamu adalah asisten yang ramah dan membantu. Jawab dalam bahasa yang digunakan pengguna.
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=60000
# Opsional: pisahkan ID channel dengan koma. Kosong = AI tersedia di semua channel.
AI_CHANNEL_IDS=
# true: bot juga menjawab ketika di-mention (selain /ai chat)
AI_REPLY_ON_MENTION=true
