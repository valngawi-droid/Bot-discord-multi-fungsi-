# Discord Developer Portal > Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Direkomendasikan saat pengembangan: command langsung muncul di server ini.
DISCORD_GUILD_ID=
# true: daftarkan slash command otomatis setiap bot dinyalakan.
REGISTER_COMMANDS_ON_START=true

# Dashboard prompt panjang: buka http://127.0.0.1:3000 di browser Android.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Opsional tetapi disarankan. Isi string rahasia buatan sendiri.
DASHBOARD_TOKEN=

# Pilih: gemini atau openai-compatible
AI_PROVIDER=gemini

# Google AI Studio / Gemini API. Jangan commit atau kirim key ke chat.
GEMINI_API_KEY=
# Model Flash-Lite stabil lebih tahan untuk beban tinggi.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
AI_MAX_RETRIES=3
# Biasanya tidak perlu diubah.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Alternatif: endpoint OpenAI-compatible milik penyedia/bridge LMArena.
LMARENA_BASE_URL=https://alamat-api-anda.example/v1
LMARENA_API_KEY=
LMARENA_MODEL=

AI_SYSTEM_PROMPT=Kamu adalah asisten yang ramah dan membantu. Jawab dalam bahasa yang digunakan pengguna.
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=60000
# Opsional: pisahkan ID channel dengan koma. Kosong = AI tersedia di semua channel.
AI_CHANNEL_IDS=
# true membutuhkan Message Content Intent di Discord Developer Portal.
# Biarkan false jika hanya memakai /ai chat (disarankan).
AI_REPLY_ON_MENTION=false
